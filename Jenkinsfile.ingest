// =============================================================================
// Jenkinsfile.ingest — Course PDF / MD / TXT → PageIndex → PostgreSQL
// =============================================================================
//
//  HOW FILE UPLOAD WORKS
//  ─────────────────────
//  1. Jenkins shows a "Build with Parameters" form.
//  2. User picks COURSE_FILE (PDF/MD/TXT) from their computer and fills in
//     COURSE_ID, ORIGINAL_FILENAME, and other options.
//  3. Jenkins encodes the file as base64 and stores it in the build workspace.
//  4. withFileParameter() decodes it back to a real file on disk.
//  5. We rsync that file + the pageindex/ scripts to the remote server.
//  6. On the server we run:
//       build_index.py   → reads PDF/MD/TXT, calls Ollama, writes _index.json
//       ingest_to_db.py  → reads _index.json, writes pages into PostgreSQL
//
//  PREREQUISITES (one-time setup)
//  ───────────────────────────────
//  Jenkins Plugins:
//    ✅ File Parameter plugin  (for base64File upload)
//    ✅ SSH Agent plugin       (for sshagent{} step)
//
//  Jenkins Credentials:
//    ID : server-ssh-key   (SSH Username with private key, user=dell)
//
//  Server must have:
//    ✅ Python 3    (sudo apt install python3 python3-venv python3-pip)
//    ✅ Docker (postgres already running via docker-compose.server.yml)
//    ✅ pandoc      (sudo apt install pandoc)   ← needed by pypandoc
//    ✅ pdfplumber  (installed via requirements.txt into venv)
// =============================================================================

pipeline {
    agent any

    // ── Parameters — shown as a form when clicking "Build with Parameters" ────
    parameters {

        // ── FILE UPLOAD ──────────────────────────────────────────────────────
        // This is the actual file the user uploads from their browser.
        // Requires the Jenkins "File Parameter" plugin.
        base64File(
            name: 'COURSE_FILE',
            description: '📄  Upload course file (PDF, Markdown .md, or plain text .txt)'
        )

        // Original filename — browser upload loses the extension, so the user
        // must tell us the real name (e.g. "java-textbook.pdf").
        string(
            name: 'ORIGINAL_FILENAME',
            defaultValue: 'course.pdf',
            description: '📝  Original filename with extension (e.g. java-textbook.pdf)'
        )

        // ── COURSE SETTINGS ──────────────────────────────────────────────────
        string(
            name: 'COURSE_ID',
            defaultValue: 'java-how-to-program',
            description: '🆔  Unique course ID stored in DB (e.g. java-how-to-program)'
        )

        string(
            name: 'SKIP_PAGES',
            defaultValue: '0',
            description: '⏩  Front-matter pages to skip (0 = auto-detect)'
        )

        // ── SERVER SETTINGS ──────────────────────────────────────────────────
        string(
            name: 'SERVER_HOST',
            defaultValue: '100.114.88.111',
            description: '🌐  Remote server IP'
        )

        string(
            name: 'SERVER_DIR',
            defaultValue: '/home/dell/chatbot',
            description: '📁  Project directory on server'
        )

        string(
            name: 'OLLAMA_URL',
            defaultValue: 'http://localhost:11434',
            description: '🤖  Ollama URL (localhost because scripts run ON the server)'
        )

        string(
            name: 'OLLAMA_MODEL',
            defaultValue: 'qwen2.5:0.5b',
            description: '🧠  Ollama model for TOC extraction'
        )
    }

    // ── Fixed environment ─────────────────────────────────────────────────────
    environment {
        SERVER_USER   = 'dell'
        SSH_CRED_ID   = 'server-ssh-key'
        SSH_OPTS      = '-o StrictHostKeyChecking=no -o ConnectTimeout=30'

        // DB on the server — scripts run ON server so we use the compose service name
        // postgres is in the same docker network, but scripts run as host process
        // so we use localhost (postgres port is mapped to host 5432)
        DB_URL = 'postgresql://chatbot:chatbot_secret@localhost:5432/coursechatbot'

        // Paths on the SERVER
        REMOTE_PAGEINDEX = "${params.SERVER_DIR}/pageindex"
        REMOTE_UPLOADS   = "${params.SERVER_DIR}/pageindex/uploads"
        REMOTE_INDEX_OUT = "${params.SERVER_DIR}/pageindex/index_output"
        VENV_DIR         = "${params.SERVER_DIR}/pageindex/.venv"
    }

    stages {

        // ── Stage 1: Save the uploaded file locally in Jenkins workspace ──────
        //
        //   base64File uploads the file encoded as base64.
        //   withFileParameter() decodes it to a real temp file on disk.
        //   We copy it into our workspace uploads/ folder with the correct name.
        // ─────────────────────────────────────────────────────────────────────
        stage('💾 Save Uploaded File') {
            steps {
                echo "📄 Saving uploaded file as: ${params.ORIGINAL_FILENAME}"
                sh "mkdir -p ${WORKSPACE}/uploads"

                withFileParameter('COURSE_FILE') {
                    // COURSE_FILE env var = path to decoded temp file
                    sh """
                        cp "\${COURSE_FILE}" "${WORKSPACE}/uploads/${params.ORIGINAL_FILENAME}"
                        echo "Saved → ${WORKSPACE}/uploads/${params.ORIGINAL_FILENAME}"
                        ls -lh "${WORKSPACE}/uploads/"
                    """
                }
            }
        }

        // ── Stage 2: Sync pageindex scripts + uploaded file to server ─────────
        //
        //   rsync sends:
        //     • pageindex/*.py          (the Python scripts)
        //     • pageindex/requirements.txt
        //     • uploads/<ORIGINAL_FILENAME>  (the course file)
        //   to the remote server under SERVER_DIR/pageindex/
        // ─────────────────────────────────────────────────────────────────────
        stage('📤 Sync to Server') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh """
                        # Ensure directories exist on server
                        ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} \\
                            "mkdir -p ${REMOTE_PAGEINDEX} ${REMOTE_UPLOADS} ${REMOTE_INDEX_OUT}"

                        # Sync pageindex Python scripts
                        rsync -avz \\
                            --include='*.py' \\
                            --include='requirements.txt' \\
                            --exclude='*' \\
                            -e "ssh ${SSH_OPTS}" \\
                            "${WORKSPACE}/pageindex/" \\
                            "${SERVER_USER}@${params.SERVER_HOST}:${REMOTE_PAGEINDEX}/"

                        # Copy the uploaded course file
                        rsync -avz \\
                            -e "ssh ${SSH_OPTS}" \\
                            "${WORKSPACE}/uploads/${params.ORIGINAL_FILENAME}" \\
                            "${SERVER_USER}@${params.SERVER_HOST}:${REMOTE_UPLOADS}/${params.ORIGINAL_FILENAME}"

                        echo "✅ Files synced to server."
                    """
                }
            }
        }

        // ── Stage 3: Setup Python venv on server ──────────────────────────────
        //
        //   Creates a virtualenv under pageindex/.venv on the server.
        //   Installs: pdfplumber, requests, psycopg2-binary, pypandoc
        //   The venv is REUSED across builds (pip only installs if not cached).
        // ─────────────────────────────────────────────────────────────────────
        stage('🐍 Setup Python Env') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh """
                        ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} bash << 'REMOTE'
                            set -e
                            cd ${REMOTE_PAGEINDEX}

                            # Create venv only if it doesn't exist yet
                            if [ ! -d "${VENV_DIR}" ]; then
                                echo "Creating virtual environment..."
                                python3 -m venv "${VENV_DIR}"
                            fi

                            echo "Installing/updating packages..."
                            ${VENV_DIR}/bin/pip install --upgrade pip -q
                            ${VENV_DIR}/bin/pip install -r requirements.txt -q
                            echo "✅ Python env ready."
REMOTE
                    """
                }
            }
        }

        // ── Stage 4: Build PageIndex ───────────────────────────────────────────
        //
        //   Runs build_index.py on the server.
        //   What it does:
        //     1. extract_text()     → reads PDF/MD/TXT, returns {page: text}
        //     2. build_toc_prompt() → selects 10 best pages, builds LLM prompt
        //     3. call_ollama()      → calls Ollama to generate TOC JSON
        //     4. Saves _index.json  → {title, chapters, pages:{1:"...", 2:"..."}}
        //
        //   Input  : uploads/<ORIGINAL_FILENAME>
        //   Output : index_output/<COURSE_ID>_index.json
        // ─────────────────────────────────────────────────────────────────────
        stage('🔍 Build Index') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh """
                        ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} bash << 'REMOTE'
                            set -e
                            cd ${REMOTE_PAGEINDEX}

                            echo ""
                            echo "=== build_index.py ==="
                            echo "Input  : ${REMOTE_UPLOADS}/${params.ORIGINAL_FILENAME}"
                            echo "Output : ${REMOTE_INDEX_OUT}/${params.COURSE_ID}_index.json"
                            echo "Ollama : ${params.OLLAMA_URL} | model: ${params.OLLAMA_MODEL}"
                            echo ""

                            ${VENV_DIR}/bin/python3 build_index.py \\
                                --input      "${REMOTE_UPLOADS}/${params.ORIGINAL_FILENAME}" \\
                                --output     "${REMOTE_INDEX_OUT}/${params.COURSE_ID}_index.json" \\
                                --ollama-url "${params.OLLAMA_URL}" \\
                                --model      "${params.OLLAMA_MODEL}" \\
                                --skip-pages ${params.SKIP_PAGES}

                            echo "✅ Index built."
REMOTE
                    """
                }
            }
        }

        // ── Stage 5: Ingest into PostgreSQL ───────────────────────────────────
        //
        //   Runs ingest_to_db.py on the server.
        //   What it does:
        //     1. Reads _index.json
        //     2. Upserts course_index row  (TOC metadata)
        //     3. Upserts course_content rows (one per page, with full text)
        //
        //   After this step the backend API /api/courses/courseIds will list
        //   the new COURSE_ID and questions can be asked about it.
        // ─────────────────────────────────────────────────────────────────────
        stage('🗄️ Ingest to DB') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh """
                        ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} bash << 'REMOTE'
                            set -e
                            cd ${REMOTE_PAGEINDEX}

                            echo ""
                            echo "=== ingest_to_db.py ==="
                            echo "Index    : ${REMOTE_INDEX_OUT}/${params.COURSE_ID}_index.json"
                            echo "Course ID: ${params.COURSE_ID}"
                            echo "DB       : ${DB_URL}"
                            echo ""

                            ${VENV_DIR}/bin/python3 ingest_to_db.py \\
                                --index     "${REMOTE_INDEX_OUT}/${params.COURSE_ID}_index.json" \\
                                --course-id "${params.COURSE_ID}" \\
                                --db-url    "${DB_URL}"

                            echo "✅ Ingest complete."
REMOTE
                    """
                }
            }
        }

        // ── Stage 6: Copy index JSON back and archive ─────────────────────────
        stage('📦 Archive') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh """
                        mkdir -p ${WORKSPACE}/index_output
                        scp ${SSH_OPTS} \\
                            "${SERVER_USER}@${params.SERVER_HOST}:${REMOTE_INDEX_OUT}/${params.COURSE_ID}_index.json" \\
                            "${WORKSPACE}/index_output/${params.COURSE_ID}_index.json"
                    """
                }
                archiveArtifacts artifacts: 'index_output/**/*.json', fingerprint: true
                echo "✅ Index JSON archived as Jenkins build artifact."
            }
        }

        // ── Stage 7: Verify course appears in API ─────────────────────────────
        stage('✅ Verify') {
            steps {
                sh """
                    echo "Checking /api/courses/courseIds on server..."
                    sleep 3
                    curl -sf http://${params.SERVER_HOST}:8080/api/courses/courseIds \\
                        | grep -q "${params.COURSE_ID}" \\
                        && echo "✅ Course '${params.COURSE_ID}' visible in API" \\
                        || echo "⚠️  Course not yet visible (backend may need restart)"
                """
            }
        }
    }

    // ── Post ──────────────────────────────────────────────────────────────────
    post {
        success {
            echo """
            ============================================================
            ✅  INGEST SUCCESSFUL

            Course ID : ${params.COURSE_ID}
            File      : ${params.ORIGINAL_FILENAME}
            Server    : ${params.SERVER_HOST}
            Index JSON: ${REMOTE_INDEX_OUT}/${params.COURSE_ID}_index.json
            DB        : coursechatbot @ ${params.SERVER_HOST}:5432

            ➡️  Ask questions at: http://${params.SERVER_HOST}:3000
            ============================================================
            """
        }
        failure {
            echo "❌ Ingest FAILED — fetching server logs..."
            sshagent(credentials: [env.SSH_CRED_ID]) {
                sh """
                    ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} \\
                        'docker logs coursechatbot-postgres --tail 20 2>/dev/null || true' || true
                """
            }
        }
        always {
            echo "Build #${env.BUILD_NUMBER} finished — ${currentBuild.currentResult}"
        }
    }
}
