// =============================================================================
// Jenkinsfile.ingest — Course PDF / MD → chunks → nomic-embed-text → ChromaDB
// =============================================================================
//
//  HOW IT WORKS
//  ─────────────
//  1. User uploads a PDF (or .md / .txt) via "Build with Parameters".
//  2. Jenkins uploads the file + ingest_to_chroma.py to the Dell server.
//  3. On the server:
//       ingest_to_chroma.py  → extract text → chunk → embed (nomic-embed-text)
//                             → store vectors in ChromaDB collection <COURSE_ID>
//  4. Backend Java (VectorRagService) queries ChromaDB on every chat request.
//
//  PREREQUISITES (one-time setup on Dell)
//  ───────────────────────────────────────
//  Jenkins Plugins:
//    ✅ File Parameter plugin  (for base64File upload)
//    ✅ SSH Agent plugin       (for sshagent{} step)
//
//  Jenkins Credentials:
//    ID : server-ssh-key   (SSH Username with private key, user=dell)
//
//  Dell server must have:
//    ✅ Python 3   (sudo apt install python3 python3-venv python3-pip)
//    ✅ ChromaDB container running  (docker compose up -d chromadb)
//    ✅ Ollama container running with nomic-embed-text pulled
// =============================================================================

pipeline {
    agent any

    parameters {
        // ── FILE UPLOAD ──────────────────────────────────────────────────────
        base64File(
            name: 'COURSE_FILE',
            description: '📄  Upload course file (PDF, Markdown .md, or plain text .txt)'
        )
        string(
            name: 'ORIGINAL_FILENAME',
            defaultValue: 'course.pdf',
            description: '📝  Original filename with extension (e.g. java-textbook.pdf)'
        )
        // ── COURSE SETTINGS ──────────────────────────────────────────────────
        string(
            name: 'COURSE_ID',
            defaultValue: 'java-how-to-program',
            description: '🆔  Unique course ID — used as ChromaDB collection name AND in the chat API'
        )
        string(
            name: 'CHUNK_SIZE',
            defaultValue: '600',
            description: '📏  Characters per chunk (600 = good balance of context vs precision)'
        )
        string(
            name: 'OVERLAP',
            defaultValue: '100',
            description: '🔁  Chunk overlap in characters (prevents cutting mid-sentence)'
        )
        // ── SERVER SETTINGS ──────────────────────────────────────────────────
        string(
            name: 'SERVER_HOST',
            defaultValue: '100.114.88.111',
            description: '🌐  Dell server IP'
        )
        string(
            name: 'SERVER_DIR',
            defaultValue: '/home/dell/chatbot',
            description: '📁  Project directory on server'
        )
        string(
            name: 'OLLAMA_URL',
            defaultValue: 'http://localhost:11434',
            description: '🤖  Ollama URL on server (localhost because scripts run ON the server)'
        )
        string(
            name: 'CHROMA_URL',
            defaultValue: 'http://localhost:8001',
            description: '🗂️  ChromaDB URL on server'
        )
        string(
            name: 'EMBED_MODEL',
            defaultValue: 'nomic-embed-text',
            description: '🧠  Ollama embedding model'
        )
    }

    environment {
        SERVER_USER      = 'dell'
        SSH_CRED_ID      = 'server-ssh-key'
        SSH_OPTS         = '-o StrictHostKeyChecking=no -o ConnectTimeout=30'
        REMOTE_PAGEINDEX = "${params.SERVER_DIR}/pageindex"
        REMOTE_UPLOADS   = "${params.SERVER_DIR}/pageindex/uploads"
        VENV_DIR         = "${params.SERVER_DIR}/pageindex/.venv"
    }

    stages {

        // ── Stage 1: Save uploaded file in Jenkins workspace ──────────────────
        stage('💾 Save Uploaded File') {
            steps {
                echo "📄 Saving uploaded file as: ${params.ORIGINAL_FILENAME}"
                sh "mkdir -p ${WORKSPACE}/uploads"
                withFileParameter('COURSE_FILE') {
                    sh """
                        cp "\${COURSE_FILE}" "${WORKSPACE}/uploads/${params.ORIGINAL_FILENAME}"
                        echo "Saved → ${WORKSPACE}/uploads/${params.ORIGINAL_FILENAME}"
                        ls -lh "${WORKSPACE}/uploads/"
                    """
                }
            }
        }

        // ── Stage 2: Sync scripts + uploaded file to Dell server ──────────────
        stage('📤 Sync to Server') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh """
                        ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} \\
                            "mkdir -p ${REMOTE_PAGEINDEX} ${REMOTE_UPLOADS}"

                        # Sync Python scripts + requirements.txt
                        rsync -avz \\
                            --include='*.py' \\
                            --include='requirements.txt' \\
                            --exclude='*' \\
                            -e "ssh ${SSH_OPTS}" \\
                            "${WORKSPACE}/pageindex/" \\
                            "${SERVER_USER}@${params.SERVER_HOST}:${REMOTE_PAGEINDEX}/"

                        # Copy the uploaded course file
                        rsync -avz \\
                            -e "ssh ${SSH_OPTS}" \\
                            "${WORKSPACE}/uploads/${params.ORIGINAL_FILENAME}" \\
                            "${SERVER_USER}@${params.SERVER_HOST}:${REMOTE_UPLOADS}/${params.ORIGINAL_FILENAME}"

                        echo "✅ Files synced."
                    """
                }
            }
        }

        // ── Stage 3: Setup Python virtualenv on server ────────────────────────
        stage('🐍 Setup Python Env') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh """
                        ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} bash << 'REMOTE'
                            set -e
                            cd ${REMOTE_PAGEINDEX}
                            if [ ! -d "${VENV_DIR}" ]; then
                                echo "Creating virtual environment..."
                                python3 -m venv "${VENV_DIR}"
                            fi
                            echo "Installing/updating packages..."
                            ${VENV_DIR}/bin/pip install --upgrade pip -q
                            ${VENV_DIR}/bin/pip install -r requirements.txt -q
                            echo "✅ Python env ready."
REMOTE
                    """
                }
            }
        }

        // ── Stage 4: Warm up nomic-embed-text model in Ollama ────────────────
        stage('🔥 Warm Up Embed Model') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh """
                        ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} bash << 'REMOTE'
                            set -e
                            echo "Warming up ${params.EMBED_MODEL} ..."
                            docker exec coursechatbot-ollama ollama pull ${params.EMBED_MODEL} 2>/dev/null || true
                            echo "✅ Embed model ready."
REMOTE
                    """
                }
            }
        }

        // ── Stage 5: Ingest → Chunk → Embed → ChromaDB ───────────────────────
        stage('🗂️ Ingest to ChromaDB') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh """
                        ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} bash << 'REMOTE'
                            set -e
                            cd ${REMOTE_PAGEINDEX}

                            echo ""
                            echo "=== ingest_to_chroma.py ==="
                            echo "Input      : ${REMOTE_UPLOADS}/${params.ORIGINAL_FILENAME}"
                            echo "Course ID  : ${params.COURSE_ID}"
                            echo "ChromaDB   : ${params.CHROMA_URL}"
                            echo "Ollama     : ${params.OLLAMA_URL}"
                            echo "Embed model: ${params.EMBED_MODEL}"
                            echo "Chunk size : ${params.CHUNK_SIZE} / overlap: ${params.OVERLAP}"
                            echo ""

                            ${VENV_DIR}/bin/python3 ingest_to_chroma.py \\
                                --input       "${REMOTE_UPLOADS}/${params.ORIGINAL_FILENAME}" \\
                                --course-id   "${params.COURSE_ID}" \\
                                --chroma-url  "${params.CHROMA_URL}" \\
                                --ollama-url  "${params.OLLAMA_URL}" \\
                                --embed-model "${params.EMBED_MODEL}" \\
                                --chunk-size  ${params.CHUNK_SIZE} \\
                                --overlap     ${params.OVERLAP}

                            echo "✅ Ingest complete."
REMOTE
                    """
                }
            }
        }

        // ── Stage 6: Verify collection exists in ChromaDB ────────────────────
        stage('✅ Verify') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh """
                        ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} bash << 'REMOTE'
                            set -e
                            echo "Checking ChromaDB collection '${params.COURSE_ID}' ..."
                            COUNT=\$(curl -sf ${params.CHROMA_URL}/api/v1/collections/${params.COURSE_ID}/count)
                            echo "✅ Collection '${params.COURSE_ID}' has \${COUNT} vectors in ChromaDB"
REMOTE
                    """
                }
                sh """
                    echo "--- Backend chat test ---"
                    curl -sf --max-time 20 \\
                        -X POST http://${params.SERVER_HOST}:8000/api/chat \\
                        -H 'Content-Type: application/json' \\
                        -d '{"courseId":"${params.COURSE_ID}","question":"What is this course about?","mode":"LEARN"}' \\
                        && echo "\\n✅ Chat API responding OK" \\
                        || echo "⚠️  Chat API not responding yet (check backend logs)"
                """
            }
        }
    }

    post {
        success {
            echo """
            ============================================================
            ✅  INGEST SUCCESSFUL

            Course ID  : ${params.COURSE_ID}
            File       : ${params.ORIGINAL_FILENAME}
            Server     : ${params.SERVER_HOST}
            ChromaDB   : ${params.CHROMA_URL}
            Embed model: ${params.EMBED_MODEL}

            ➡️  Ask questions at: http://${params.SERVER_HOST}:3000
            ============================================================
            """
        }
        failure {
            echo "❌ Ingest FAILED — fetching server logs..."
            sshagent(credentials: [env.SSH_CRED_ID]) {
                sh """
                    ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} \\
                        'docker logs coursechatbot-chromadb --tail 30 2>/dev/null || true
                         docker logs coursechatbot-ollama   --tail 20 2>/dev/null || true' || true
                """
            }
        }
        always {
            echo "Build #${env.BUILD_NUMBER} — ${currentBuild.currentResult}"
        }
    }
}
