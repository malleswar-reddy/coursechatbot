// =============================================================================
// Jenkinsfile.migrate — Flyway Database Migration Job
// =============================================================================
//
//  TWO MODES — choose with DEPLOY_MODE parameter:
//
//  LOCAL  (default — no SSH keys needed)
//  ──────
//  Jenkins AND PostgreSQL run on the SAME server.
//  Flyway docker runs directly — no SSH, no rsync needed.
//  ✅ Use this now.
//
//  REMOTE  (SSH to separate server — set up later)
//  ──────
//  Jenkins is on a different machine. Uses SSH + rsync.
//  Requires Jenkins credential ID: server-ssh-key
//
//  COMMANDS
//  ────────
//    info     → show which migrations are applied / pending  (safe, read-only)
//    migrate  → apply all pending V*.sql files
//    validate → check SQL files haven't changed after applying
//    repair   → fix failed migration checksums
//    baseline → mark existing DB as V1  (first-time only)
// =============================================================================

pipeline {
    agent any

    parameters {
        choice(
            name: 'DEPLOY_MODE',
            choices: ['local', 'remote'],
            description: '''Deploy mode:
  local  = Jenkins runs ON the same server as Docker (no SSH needed) ✅
  remote = Jenkins SSHes to a separate server (needs server-ssh-key credential)'''
        )

        choice(
            name: 'FLYWAY_COMMAND',
            choices: ['info', 'migrate', 'validate', 'repair', 'baseline'],
            description: '''Flyway command:
  info     → show migration status (safe, run first)
  migrate  → apply all pending SQL migrations
  validate → verify applied migrations match SQL files
  repair   → fix checksum mismatches in flyway_schema_history
  baseline → mark existing DB as V1 (first-time only)'''
        )

        string(
            name: 'SERVER_HOST',
            defaultValue: '100.114.88.111',
            description: '🌐  Server IP (used for REMOTE mode SSH + smoke test URLs)'
        )

        string(
            name: 'SERVER_DIR',
            defaultValue: '/home/dell/chatbot',
            description: '📁  Project dir on server (REMOTE mode only)'
        )

        string(
            name: 'DB_HOST',
            defaultValue: 'localhost',
            description: '🗄️  DB host as seen from the server (localhost = postgres mapped to host :5432)'
        )

        string(
            name: 'DB_PORT',
            defaultValue: '5432',
            description: 'DB port'
        )

        string(
            name: 'DB_NAME',
            defaultValue: 'coursechatbot',
            description: 'DB name'
        )

        string(
            name: 'DB_USER',
            defaultValue: 'chatbot',
            description: 'DB username'
        )

        string(
            name: 'DB_PASSWORD',
            defaultValue: 'chatbot_secret',
            description: '🔑  DB password'
        )

        string(
            name: 'OLLAMA_MODEL',
            defaultValue: 'qwen2.5:0.5b',
            description: '🤖  Ollama model (recorded in build info — used when restarting backend after migration)'
        )

        string(
            name: 'FLYWAY_VERSION',
            defaultValue: '9-alpine',
            description: 'Flyway Docker image tag'
        )
    }

    environment {
        SERVER_USER   = 'dell'
        SSH_CRED_ID   = 'server-ssh-key'
        SSH_OPTS      = '-o StrictHostKeyChecking=no -o ConnectTimeout=30'
        // In LOCAL mode migration dir = Jenkins workspace path
        // In REMOTE mode = path on remote server
        MIGRATION_DIR = "${params.DEPLOY_MODE == 'local' ? env.WORKSPACE : params.SERVER_DIR}/backend/src/main/resources/db/migration"
    }

    stages {

        // ── Stage 1: Checkout ─────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Source ready at ${WORKSPACE}"
                echo "🚀 Deploy mode  : ${params.DEPLOY_MODE}"
                echo "🗄️  Flyway cmd   : ${params.FLYWAY_COMMAND}"
                echo "🤖 Ollama model : ${params.OLLAMA_MODEL}"
                echo "📁 Migration dir: ${env.MIGRATION_DIR}"
            }
        }

        // ── Stage 2: Sync migration files (REMOTE mode only) ──────────────────
        // LOCAL mode: files already in Jenkins workspace → skip
        stage('Sync Migration Files') {
            when { expression { params.DEPLOY_MODE == 'remote' } }
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh """
                        echo "📤 Syncing migration SQL files to server..."
                        ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} \
                            "mkdir -p ${env.MIGRATION_DIR}"
                        rsync -avz \
                            -e "ssh ${SSH_OPTS}" \
                            "${WORKSPACE}/backend/src/main/resources/db/migration/" \
                            "${SERVER_USER}@${params.SERVER_HOST}:${env.MIGRATION_DIR}/"
                        echo "✅ Migration files synced."
                    """
                }
            }
        }

        // ── Stage 3: Verify PostgreSQL is running ─────────────────────────────
        stage('Verify Postgres') {
            steps {
                script {
                    if (params.DEPLOY_MODE == 'local') {
                        sh """
                            echo "🗄️  Checking PostgreSQL locally..."
                            docker inspect --format='Status: {{.State.Status}}  Health: {{.State.Health.Status}}' \
                                coursechatbot-postgres 2>/dev/null \
                                || echo 'WARNING: coursechatbot-postgres container not found'
                            docker exec coursechatbot-postgres \
                                pg_isready -U chatbot -d coursechatbot \
                                && echo '✅ PostgreSQL is ready' \
                                || { echo '❌ PostgreSQL not ready — start it first:'; \
                                     echo '   docker compose -f docker-compose.server.yml up -d postgres'; \
                                     exit 1; }
                        """
                    } else {
                        sshagent(credentials: [env.SSH_CRED_ID]) {
                            sh """
                                ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} \
                                    "docker inspect --format='Status: {{.State.Status}}  Health: {{.State.Health.Status}}' coursechatbot-postgres 2>/dev/null || true"
                                ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} \
                                    "docker exec coursechatbot-postgres pg_isready -U chatbot -d coursechatbot \
                                     && echo '✅ PostgreSQL is ready' \
                                     || { echo '❌ PostgreSQL not ready'; exit 1; }"
                            """
                        }
                    }
                }
            }
        }

        // ── Stage 4: Migration Status (Before) ────────────────────────────────
        stage('Migration Status (Before)') {
            steps {
                script {
                    def mdir = env.MIGRATION_DIR
                    def flywayArgs = """-url="jdbc:postgresql://${params.DB_HOST}:${params.DB_PORT}/${params.DB_NAME}" \
                                    -user="${params.DB_USER}" \
                                    -password="${params.DB_PASSWORD}" \
                                    -locations="filesystem:/flyway/sql" """

                    if (params.DEPLOY_MODE == 'local') {
                        sh """
                            echo "📋 Flyway status BEFORE:"
                            docker run --rm --network host \
                                -v "${mdir}:/flyway/sql" \
                                flyway/flyway:${params.FLYWAY_VERSION} \
                                ${flywayArgs} \
                                info || true
                        """
                    } else {
                        sshagent(credentials: [env.SSH_CRED_ID]) {
                            sh """
                                ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} bash -s << 'REMOTE'
                                    flyway_run() {
                                        docker run --rm --network host \
                                            -v "${mdir}:/flyway/sql" \
                                            flyway/flyway:${params.FLYWAY_VERSION} \
                                            -url="jdbc:postgresql://${params.DB_HOST}:${params.DB_PORT}/${params.DB_NAME}" \
                                            -user="${params.DB_USER}" \
                                            -password="${params.DB_PASSWORD}" \
                                            -locations="filesystem:/flyway/sql" "\$1"
                                    }
                                    flyway_run info
REMOTE
                            """
                        }
                    }
                }
            }
        }

        // ── Stage 5: Run Flyway Command ────────────────────────────────────────
        stage('Run Flyway') {
            when { expression { params.FLYWAY_COMMAND != 'info' } }
            steps {
                script {
                    def mdir = env.MIGRATION_DIR
                    def cmd  = params.FLYWAY_COMMAND

                    if (params.DEPLOY_MODE == 'local') {
                        sh """
                            echo "🚀 Running: flyway ${cmd}"
                            docker run --rm --network host \
                                -v "${mdir}:/flyway/sql" \
                                flyway/flyway:${params.FLYWAY_VERSION} \
                                -url="jdbc:postgresql://${params.DB_HOST}:${params.DB_PORT}/${params.DB_NAME}" \
                                -user="${params.DB_USER}" \
                                -password="${params.DB_PASSWORD}" \
                                -locations="filesystem:/flyway/sql" \
                                -outOfOrder=false \
                                ${cmd}
                            echo "✅ flyway ${cmd} complete."
                        """
                    } else {
                        sshagent(credentials: [env.SSH_CRED_ID]) {
                            sh """
                                ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} bash -s << 'REMOTE'
                                    flyway_run() {
                                        docker run --rm --network host \
                                            -v "${mdir}:/flyway/sql" \
                                            flyway/flyway:${params.FLYWAY_VERSION} \
                                            -url="jdbc:postgresql://${params.DB_HOST}:${params.DB_PORT}/${params.DB_NAME}" \
                                            -user="${params.DB_USER}" \
                                            -password="${params.DB_PASSWORD}" \
                                            -locations="filesystem:/flyway/sql" \
                                            -outOfOrder=false "\$1"
                                    }
                                    flyway_run ${cmd}
REMOTE
                                echo "✅ flyway ${cmd} complete."
                            """
                        }
                    }
                }
            }
        }

        // ── Stage 6: Migration Status (After) ─────────────────────────────────
        stage('Migration Status (After)') {
            when { expression { params.FLYWAY_COMMAND != 'info' } }
            steps {
                script {
                    def mdir = env.MIGRATION_DIR

                    if (params.DEPLOY_MODE == 'local') {
                        sh """
                            echo "📋 Flyway status AFTER:"
                            docker run --rm --network host \
                                -v "${mdir}:/flyway/sql" \
                                flyway/flyway:${params.FLYWAY_VERSION} \
                                -url="jdbc:postgresql://${params.DB_HOST}:${params.DB_PORT}/${params.DB_NAME}" \
                                -user="${params.DB_USER}" \
                                -password="${params.DB_PASSWORD}" \
                                -locations="filesystem:/flyway/sql" \
                                info
                        """
                    } else {
                        sshagent(credentials: [env.SSH_CRED_ID]) {
                            sh """
                                ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} bash -s << 'REMOTE'
                                    flyway_run() {
                                        docker run --rm --network host \
                                            -v "${mdir}:/flyway/sql" \
                                            flyway/flyway:${params.FLYWAY_VERSION} \
                                            -url="jdbc:postgresql://${params.DB_HOST}:${params.DB_PORT}/${params.DB_NAME}" \
                                            -user="${params.DB_USER}" \
                                            -password="${params.DB_PASSWORD}" \
                                            -locations="filesystem:/flyway/sql" "\$1"
                                    }
                                    flyway_run info
REMOTE
                            """
                        }
                    }
                }
            }
        }

        // ── Stage 7: Verify Tables ─────────────────────────────────────────────
        stage('Verify Tables') {
            steps {
                script {
                    def psqlCmd = """docker exec coursechatbot-postgres \
                        psql -U chatbot -d coursechatbot -c '\\dt' && \
                        docker exec coursechatbot-postgres \
                        psql -U chatbot -d coursechatbot \
                        -c 'SELECT version, description, installed_on, success FROM flyway_schema_history ORDER BY installed_rank;'"""

                    if (params.DEPLOY_MODE == 'local') {
                        sh """
                            echo "🔍 Verifying tables locally..."
                            ${psqlCmd}
                        """
                    } else {
                        sshagent(credentials: [env.SSH_CRED_ID]) {
                            sh """
                                ssh ${SSH_OPTS} ${SERVER_USER}@${params.SERVER_HOST} "${psqlCmd}"
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo """
            ============================================================
            ✅  FLYWAY ${params.FLYWAY_COMMAND.toUpperCase()} SUCCESSFUL  [${params.DEPLOY_MODE} mode]

            Server       : ${params.SERVER_HOST}
            DB           : ${params.DB_NAME} @ ${params.DB_HOST}:${params.DB_PORT}
            Ollama model : ${params.OLLAMA_MODEL}
            Migration dir: ${env.MIGRATION_DIR}
            ============================================================
            """
        }
        failure {
            echo """
            ❌ FLYWAY ${params.FLYWAY_COMMAND.toUpperCase()} FAILED  [${params.DEPLOY_MODE} mode]

            Common fixes:
            1. migrate failed mid-way  → fix SQL, run 'repair', then 'migrate' again
            2. Checksum mismatch       → NEVER edit applied V*.sql; add new V{n+1}__.sql
            3. Postgres not running    → docker compose -f docker-compose.server.yml up -d postgres
            4. First-time existing DB  → run 'baseline' first, then 'migrate'
            """
        }
        always {
            echo "Build #${env.BUILD_NUMBER} — ${currentBuild.currentResult} — ${params.FLYWAY_COMMAND} [${params.DEPLOY_MODE}]"
        }
    }
}
